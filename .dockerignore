# Docker ignore file for Nitrox
# Exclude unnecessary files from Docker build context

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
*.md
docs/

# IDE and editor files
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/

# Build outputs
bin/
obj/
out/
publish/

# NuGet
packages/
*.nupkg
*.snupkg

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Logs
logs/
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# Nitrox specific
saves/
gamefiles/
config/
*.backup

# Development tools
.kiro/